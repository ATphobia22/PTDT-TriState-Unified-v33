{
  "name": "ptdt-tristate-unified-v33",
  "private": true,
  "version": "33.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:init": "npx cap init PTDTV33 com.ptdt.unified --web-dir dist",
    "cap:add:ios": "npx cap add ios",
