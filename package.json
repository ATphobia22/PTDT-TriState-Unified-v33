{
  "name": "ptdt-tristate-unified-v33",
  "private": true,
  "version": "33.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "electron:dev": "vite build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "checksums": "powershell -File scripts/checksums.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "maplibre-gl": "^4.7.0",
    "pmtiles": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@webgpu/types": "^0.1.40",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.ptdt.unified.v33",
    "productName": "PTDT Unified V33",
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!dist/**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin"
    ],
    "compression": "maximum",
    "removePackageScripts": true,
    "win": {
      "target": ["nsis", "portable"],
      "arch": ["x64"],
      "signAndEditExecutable": false,
      "artifactName": "PTDT-Unified-V33-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PTDT Unified V33",
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "PTDT-Unified-V33-Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ATphobia22",
        "repo": "PTDT-TriState-Unified-v33"
      }
    ]
  }
}
